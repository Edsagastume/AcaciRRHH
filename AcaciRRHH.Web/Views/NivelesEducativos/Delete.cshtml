@model AcaciRRHH.Web.Models.NivelEducativo

@{
    ViewData["Title"] = "Eliminar";
}



<h3>¿Estas seguro de eliminar este registro?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.GradoAcademico)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.GradoAcademico)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Institucion)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Institucion)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.TituloObtenido)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TituloObtenido)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.FechaFin)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.FechaFin)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Comentarios)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Comentarios)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="IdNivelEducativo" />
        <input type="submit" value="Eliminar" class="btn btn-danger" />
        <a asp-action="Details" asp-controller="Personas" asp-route-id="@Model?.IdPersona" class="btn btn-secondary">Volver</a> 
    </form>
</div>