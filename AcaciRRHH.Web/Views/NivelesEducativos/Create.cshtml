@model AcaciRRHH.Web.Models.NivelEducativo

@{
    ViewData["Title"] = "Agregar Nivel Educativo";
}

<h1>Agregar</h1>

<h4>Nivel Educativo</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="IdPersona" />
            <div class="form-group">
                <label asp-for="GradoAcademico"  class="control-label">Grado Academico</label>
                <select asp-for="GradoAcademico" class="form-control" asp-items="Html.GetEnumSelectList<AcaciRRHH.Web.Models.GradoAcademicoEnum>()"></select>
                <span asp-validation-for="GradoAcademico" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Institucion" class="control-label">Institución</label>
                <input asp-for="Institucion" class="form-control" />
                <span asp-validation-for="Institucion" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TituloObtenido" class="control-label">Titulo Obtenido</label>
                <input asp-for="TituloObtenido" class="form-control" />
                <span asp-validation-for="TituloObtenido" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="FechaFin" class="control-label">Fecha de Finalización</label>
                <input asp-for="FechaFin" class="form-control" />
                <span asp-validation-for="FechaFin" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Comentarios" class="control-label"></label>
                <textarea asp-for="Comentarios" class="form-control"></textarea>
                <span asp-validation-for="Comentarios" class="text-danger"></span>
            </div>
            <div class="form-group mt-4">
                <input type="submit" value="Agregar" class="btn btn-primary" />
                <a asp-controller="Personas" asp-action="Details" asp-route-id="@Model.IdPersona" class="btn btn-danger">Cancelar</a>
            </div>
        </form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}