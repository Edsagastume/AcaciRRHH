@model IEnumerable<AcaciRRHH.Web.Models.HistorialDisciplinario>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

@if (User.IsInRole("Administrador"))
{
    <p>
        <a asp-action="Create">Create New</a>
    </p>
}
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.FechaIncidente)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TipoIncidente)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Descripcion)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AccionTomada)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RutaIncidente)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RegistradoPor)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FechaRegistro)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Empleado)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.FechaIncidente)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TipoIncidente)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Descripcion)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AccionTomada)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.RutaIncidente)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.RegistradoPor)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FechaRegistro)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Empleado!.CodigoEmpleado)
            </td>
            <td>
                <div class="d-flex" style="gap: 8px;" role="group">
                    @if (User.IsInRole("Administrador"))
                    {
                        <a asp-action="Edit" asp-route-id="@item.IdIncidente">Edit</a>
                        <a asp-action="Details" asp-route-id="@item.IdIncidente">Details</a>
                        <a asp-action="Delete" asp-route-id="@item.IdIncidente">Delete</a>
                    }
                    else
                    {
                        <a asp-action="Details" asp-route-id="@item.IdIncidente">Details</a>
                    }
                </div>
            </td>
        </tr>
}
    </tbody>
</table>