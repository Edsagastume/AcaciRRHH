@model IEnumerable<AcaciRRHH.Web.Models.Persona>;

@{
    ViewData["Title"] = "Listado de Personas";
    int rowNumber = 0;
}

<h1>@ViewData["Title"]</h1>

<form asp-controller="Personas" asp-action="Index" method="get" class="mb-3">
    <div class="input-group">
        <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Buscar por nombre o apellido..." />
        <button class="btn btn-outline-secondary" type="submit">Buscar</button>
        <a asp-action="Index" class="btn btn-outline-danger">Limpiar</a>
    </div>
</form>

@if (User.IsInRole("Administrador"))
{
    <p>
        <a asp-action="Create" class="btn btn-primary">Registrar Nueva Persona</a>
    </p>
}

<table class="table table-striped table-bordered">
    <thead class="thead-dark">
        <tr>
            <th style="width: 50px;">#</th>
            <th>Nombre Completo</th>
            <th style="width: 100px;">Empleado</th> @* Nueva columna para indicar si es empleado *@
            <th style="width: 100px;"> Gobernanza o Comités</th>
            <th style="width: 250px; min-width: 250px;">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            rowNumber++;
            <tr>
                <td>@rowNumber</td>
                <td>@item.Nombre @item.Apellidos</td>

                <td class="text-center">
                    @* --- Para mostrar empleados activos en 'Es Empleado?' --- *@
                    @if (item.Empleado != null && item.Empleado.Estado == EstadoEmpleado.Activo)
                    {
                        <span class="badge bg-success">Sí</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">No</span>
                    }
                </td>
                <td class="text-center"> 
                    @if (item.Directivos != null && item.Directivos.Any())
                    {
                        <span class="badge bg-success">Sí</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">No</span>
                    }
                </td>
 
                <td class="text-nowrap">
                    <div class="d-flex" style="gap: 8px;" role="group">
                        @if (User.IsInRole("Administrador"))
                        {
                            <a asp-action="Edit" asp-route-id="@item.IdPersona" class="btn btn-sm btn-info me-1">Editar</a>
                        }
                        @if ((User.IsInRole("Administrador")) || (User.IsInRole("Consulta")))
                        {
                        <a asp-action="Details" asp-route-id="@item.IdPersona" class="btn btn-sm btn-secondary me-1">Detalles</a>
                        }
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>