@model AcaciRRHH.Web.Models.Directivo

@{
    ViewData["Title"] = "Detalles del Directivo";
    var historialCompleto = ViewData["HistorialCompleto"] as List<AcaciRRHH.Web.Models.HistorialDirectivo>;
}

<h2>Detalles del Directivo</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Persona)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Persona!.NombreCompleto)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.CargoDirectivo)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.CargoDirectivo)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.FechaInicioMandato)
        </dt>
        <dd class="col-sm-10">
            @Model.FechaInicioMandato.ToLocalTime().ToString("dd/MM/yyyy")
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.FechaFinMandato)
        </dt>
        <dd class="col-sm-10">
            @(Model.FechaFinMandato.HasValue ? Model.FechaFinMandato.Value.ToLocalTime().ToString("dd/MM/yyyy") : "Actual")
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.TipoMiembro)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.TipoMiembro)
        </dd>
    </dl>
</div>
<div>
    @if (User.IsInRole("Administrador"))
    {
    <a asp-action="Edit" asp-route-id="@Model.IdDirectivo" class="btn btn-warning">Editar</a>
    }
    <a asp-action="Index" class="btn btn-secondary">Volver a la Lista</a>
</div>

<hr />

<h3>Historial de Mandatos</h3>

<p>
    @if (User.IsInRole("Administrador"))
    {
    <a asp-controller="HistorialDirectivos" asp-action="Create" asp-route-idDirectivo="@Model.IdDirectivo" class="btn btn-success">Registrar Nuevo Historial</a>
    }
</p>

@if (historialCompleto != null && historialCompleto.Any())
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                
                <th>Fecha Inicio</th>
                <th>Fecha Fin</th>
                <th>Cargo</th>
                <th>Tipo Miembro</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var historial in historialCompleto)
            {
                <tr>
                    
                    <td>@historial.FechaInicioMandato.ToLocalTime().ToString("dd/MM/yyyy")</td>
                    <td>@(historial.FechaFinMandato.HasValue ? historial.FechaFinMandato.Value.ToLocalTime().ToString("dd/MM/yyyy") : "N/A")</td>
                    <td>@Html.DisplayFor(modelItem => historial.Cargo)</td>
                    <td>@Html.DisplayFor(modelItem => Model.TipoMiembro)</td>
                    <td>@Html.DisplayFor(modelItem => Model.Estado)</td>
                    <td>
                        <a asp-controller="HistorialDirectivos" asp-action="Details" asp-route-id="@historial.IdHistorialDirectivo" class="btn btn-sm btn-secondary">Detalles</a>
                        @if (User.IsInRole("Administrador"))
                        {
                        <span>|</span>
                        <a asp-controller="HistorialDirectivos" asp-action="Edit" asp-route-id="@historial.IdHistorialDirectivo" class="btn btn-sm btn-info">Editar</a> 
                        <span>|</span>
                        <a asp-controller="HistorialDirectivos" asp-action="Delete" asp-route-id="@historial.IdHistorialDirectivo" class="btn btn-sm btn-danger">Eliminar</a>
                        }                    
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No hay historial de mandatos registrado para este directivo.</p>
}