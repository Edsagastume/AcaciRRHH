@model AcaciRRHH.Web.Models.Permiso

@{
    ViewData["Title"] = "Registrar Permiso";
}

<h1>Registrar Permiso</h1>

<h4>Para: @ViewData["NombreEmpleado"]</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="IdEmpleado" value="@Model.IdEmpleado" />
            <div class="form-group">
                <label asp-for="FechaSolicitud" class="control-label"></label>
                <input asp-for="FechaSolicitud" class="form-control" type="date" value="@(Model.FechaSolicitud > DateTime.MinValue ? Model.FechaSolicitud.ToString("yyyy-MM-dd") : "")" />
                <span asp-validation-for="FechaSolicitud" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="FechaInicio" class="control-label"></label>
                <input asp-for="FechaInicio" class="form-control" type="date" value="@(Model.FechaInicio > DateTime.MinValue ? Model.FechaInicio.ToString("yyyy-MM-dd") : "")" />
                <span asp-validation-for="FechaInicio" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="FechaFin" class="control-label"></label>
                <input asp-for="FechaFin" class="form-control" type="date" value="@(Model.FechaFin > DateTime.MinValue ? Model.FechaFin.ToString("yyyy-MM-dd") : "")" />
                <span asp-validation-for="FechaFin" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Motivo" class="control-label"></label>
                <textarea asp-for="Motivo" class="form-control"></textarea>
                <span asp-validation-for="Motivo" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="Aprobado" /> @Html.DisplayNameFor(model => model.Aprobado)
                </label>
            </div>
            <div class="form-group">
                <label asp-for="Comentarios" class="control-label"></label>
                <textarea asp-for="Comentarios" class="form-control"></textarea>
                <span asp-validation-for="Comentarios" class="text-danger"></span>
            </div>
            
            <div class="form-group mt-3">
                <input type="submit" value="Guardar" class="btn btn-primary" />
                <a asp-controller="Empleados" asp-action="Details" asp-route-id="@Model.IdEmpleado"class="btn btn-danger">Cancelar</a>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}