@model AcaciRRHH.Web.Models.Empleado

@{
    ViewData["Title"] = "Registrar Nuevo Empleado";
}

<h1>@ViewData["Title"]</h1>

<h4>Datos del Empleado</h4>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div> @* ¡Asegúrate de que esta línea esté aquí! *@

            @if (ViewData["NoPersonsAvailable"] != null)
            {
                <div class="alert alert-warning">@ViewData["NoPersonsAvailable"]</div>
            }
            else
            {
                <div class="form-group mb-3">
                    <label asp-for="IdPersona" class="control-label">Persona</label>
                    <select asp-for="IdPersona" class="form-control" asp-items="ViewBag.IdPersona"></select>
                    <span asp-validation-for="IdPersona" class="text-danger"></span>
                </div>
            }

            <div class="form-group mb-3">
                <label asp-for="CodigoEmpleado" class="control-label"></label>
                <input asp-for="CodigoEmpleado" class="form-control" />
                <span asp-validation-for="CodigoEmpleado" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="FechaContratacion" class="control-label"></label>
                <input asp-for="FechaContratacion" type="date" class="form-control" />
                <span asp-validation-for="FechaContratacion" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Puesto" class="control-label"></label>
                <input asp-for="Puesto" class="form-control" />
                <span asp-validation-for="Puesto" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Salario" class="control-label"></label>
                <input asp-for="Salario" type="number" step="0.01" class="form-control" /> @* Added type="number" and step="0.01" *@
                <span asp-validation-for="Salario" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Departamento" class="control-label"></label>
                <input asp-for="Departamento" class="form-control" />
                <span asp-validation-for="Departamento" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Agencia" class="control-label"></label>
                <select asp-for="Agencia" class="form-control" asp-items="Html.GetEnumSelectList<AcaciRRHH.Web.Models.Agencia>()"></select>
                <span asp-validation-for="Agencia" class="text-danger"></span>
            </div>

            <div class="form-group mt-4">
                <input type="submit" value="Crear" class="btn btn-success" />
                <a asp-action="Index" class="btn btn-secondary">Cancelar y Volver</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}