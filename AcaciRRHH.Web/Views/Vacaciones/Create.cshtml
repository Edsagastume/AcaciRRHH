@model AcaciRRHH.Web.Models.Vacacion

@{
    ViewData["Title"] = "Registrar Vacaciones";
}

<h1>Registrar Vacaciones</h1>

<h4>Para: @ViewData["NombreEmpleado"]</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="IdEmpleado" value="@Model.IdEmpleado" />
            <input type="hidden" asp-for="SonConsecutivas" id="sonConsecutivasHidden" value="true" />

            <div class="form-group">
                <label asp-for="FechaSolicitud" class="control-label"></label>
                <input asp-for="FechaSolicitud" class="form-control datepicker" id="FechaSolicitud" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                <span asp-validation-for="FechaSolicitud" class="text-danger"></span>
            </div>

            <div class="form-group form-check">
                <input type="checkbox" id="noConsecutivasCheck" class="form-check-input" />
                <label class="form-check-label" for="noConsecutivasCheck">Vacaciones No Consecutivas</label>
            </div>

            <div id="consecutiveDates">
                <div class="form-group">
                    <label asp-for="FechaInicio" class="control-label"></label>
                    <input asp-for="FechaInicio" class="form-control datepicker" id="FechaInicio" value="@(Model.FechaInicio.HasValue ? Model.FechaInicio.Value.ToString("yyyy-MM-dd") : "")" />
                    <span asp-validation-for="FechaInicio" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="FechaFin" class="control-label"></label>
                    <input asp-for="FechaFin" class="form-control datepicker" id="FechaFin" value="@(Model.FechaFin.HasValue ? Model.FechaFin.Value.ToString("yyyy-MM-dd") : "")" />
                    <span asp-validation-for="FechaFin" class="text-danger"></span>
                </div>
            </div>

            <div id="nonConsecutiveDates" style="display: none;">
                <div class="form-group">
                    <label asp-for="FechasNoConsecutivas" class="control-label">Fechas No Consecutivas</label>
                    <input asp-for="FechasNoConsecutivas" class="form-control" id="fechasNoConsecutivasInput" />
                    <span asp-validation-for="FechasNoConsecutivas" class="text-danger"></span>
                    <small class="form-text text-muted">Seleccione una o varias fechas del calendario.</small>
                </div>
            </div>

            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="Aprobado" id="Aprobado" /> @Html.DisplayNameFor(model => model.Aprobado)
                </label>
            </div>
            <div class="form-group">
                <label asp-for="Comentarios" class="control-label"></label>
                <textarea asp-for="Comentarios" class="form-control" id="Comentarios" ></textarea>
                <span asp-validation-for="Comentarios" class="text-danger"></span>
            </div>
            
            <div class="form-group mt-3">
                <input type="submit" value="Crear" class="btn btn-primary" />
                <a asp-controller="Empleados" asp-action="Details" asp-route-id="@Model.IdEmpleado"class="btn btn-danger">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.9.0/css/bootstrap-datepicker.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.9.0/js/bootstrap-datepicker.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.9.0/locales/bootstrap-datepicker.es.min.js"></script>

    <script>
        $(document).ready(function () {
            var noConsecutivasCheckbox = $('#noConsecutivasCheck');
            var sonConsecutivasHidden = $('#sonConsecutivasHidden');
            
            var consecutiveDatesDiv = $('#consecutiveDates');
            var nonConsecutiveDatesDiv = $('#nonConsecutiveDates');
            
            var fechaInicioInput = $('#FechaInicio');
            var fechaFinInput = $('#FechaFin');
            var fechasNoConsecutivasInput = $('#fechasNoConsecutivasInput');

            // Initialize Datepicker for all date fields
            $('.datepicker').datepicker({
                format: "yyyy-mm-dd",
                language: 'es',
                todayHighlight: true,
                autoclose: true
            });

            // Initialize Datepicker for non-consecutive dates
            fechasNoConsecutivasInput.datepicker({
                format: "yyyy-mm-dd",
                multidate: true,
                language: 'es',
                todayHighlight: true
            });

            // Toggle visibility on checkbox change
            noConsecutivasCheckbox.change(function () {
                if ($(this).is(':checked')) {
                    // Non-consecutive
                    sonConsecutivasHidden.val('false');
                    consecutiveDatesDiv.hide();
                    nonConsecutiveDatesDiv.show();
                    fechaInicioInput.val('');
                    fechaFinInput.val('');
                } else {
                    // Consecutive
                    sonConsecutivasHidden.val('true');
                    consecutiveDatesDiv.show();
                    nonConsecutiveDatesDiv.hide();
                    fechasNoConsecutivasInput.val('');
                }
            });

            // Set initial state
            noConsecutivasCheckbox.trigger('change');
        });
    </script>
}