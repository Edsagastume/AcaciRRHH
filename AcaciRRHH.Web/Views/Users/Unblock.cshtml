@model AcaciRRHH.Web.Models.ApplicationUser

@{
    ViewData["Title"] = "Desbloquear Usuario";
}

<h2>Desbloquear Usuario</h2>

<h3>¿Estas seguro de Desbloquear al usuario?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.UserName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.UserName)
        </dd>
    </dl>
    
    <form asp-action="Unblock">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Desbloquear" class="btn btn-primary" /> |
        <a asp-action="Index" class="btn btn-secondary">Regresar</a>
    </form>
</div>
