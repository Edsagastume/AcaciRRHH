@model AcaciRRHH.Web.Models.ApplicationUser

@{
    ViewData["Title"] = "Bloquear Usuario";
}

<h2>Bloquear Usuario</h2>

<h4>¿Estas seguro de bloquear al usuario?</h4>
<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.UserName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.UserName)
        </dd>
    </dl>
    
    <form asp-action="Block">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Bloquear" class="btn btn-danger" /> |
        <a asp-action="Index" class="btn btn-primary">Regresar</a>
    </form>
</div>
