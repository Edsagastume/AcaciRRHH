@model AcaciRRHH.Web.Models.Atestado

@{
    ViewData["Title"] = "Editar Atestado";
}

<h1>@ViewData["Title"]</h1>

<h4>Atestado</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="IdAtestado" />
            <input type="hidden" asp-for="IdPersona" />
            <input type="hidden" asp-for="RutaArchivo" /> @* Keep existing path if no new file *@

            <div class="form-group">
                <label asp-for="TipoAtestado" class="control-label"></label>
                <input asp-for="TipoAtestado" class="form-control" />
                <span asp-validation-for="TipoAtestado" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label class="control-label">Subir Nuevo Archivo (Opcional)</label>
                <input type="file" name="archivo" class="form-control" />
            </div>
            <div class="form-group">
                <label asp-for="Comentarios" class="control-label"></label>
                <textarea asp-for="Comentarios" class="form-control"></textarea>
                <span asp-validation-for="Comentarios" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="Activo" /> @Html.DisplayNameFor(model => model.Activo)
                </label>
            </div>
            <div class="form-group">
                <label asp-for="SubidoPor" class="control-label"></label>
                <input asp-for="SubidoPor" class="form-control" />
                <span asp-validation-for="SubidoPor" class="text-danger"></span>
            </div>
            <div class="form-group">
                @if (User.IsInRole("Administrador"))
                {
                    <input type="submit" value="Guardar" class="btn btn-primary" />
                }
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Details" asp-controller="Personas" asp-route-id="@Model.IdPersona">Volver a Detalles de Persona</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}