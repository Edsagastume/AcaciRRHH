@model AcaciRRHH.Web.Models.Atestado

@{
    ViewData["Title"] = "Detalles de Atestado";
}

<h1>@ViewData["Title"]</h1>

<div>
    <h4>Atestado</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.TipoAtestado)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TipoAtestado)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.NombreOriginalArchivo)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.NombreOriginalArchivo)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.FechaSubida)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.FechaSubida)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.RutaArchivo)
        </dt>
        <dd class = "col-sm-10">
            @if (!string.IsNullOrEmpty(Model.RutaArchivo))
            {
                <a href="@Url.Content(Model.RutaArchivo)" target="_blank">Ver Archivo</a>
            }
            else
            {
                <span>No hay archivo adjunto</span>
            }
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Comentarios)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Comentarios)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.CreatedBy)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CreatedBy)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Persona)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Persona!.NombreCompleto)
        </dd>
    </dl>
</div>
<div>
    @if (User.IsInRole("Administrador"))
    {
    <a asp-action="Delete" asp-controller="Atestados" asp-route-id="@Model.IdAtestado" class="btn btn-danger">Eliminar</a>
    }
    <a asp-action="Details" asp-controller="Personas" asp-route-id="@Model.IdPersona" class="btn btn-secondary">Volver</a>
</div>
