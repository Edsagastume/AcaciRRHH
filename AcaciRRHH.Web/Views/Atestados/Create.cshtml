@model AcaciRRHH.Web.Models.Atestado

@{
    ViewData["Title"] = "Cargar Atestado";
}

<h1>@ViewData["Title"]</h1>

<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="IdPersona" />

            <div class="form-group mb-3">
                <label asp-for="TipoAtestado" class="control-label"></label>
                <input asp-for="TipoAtestado" class="form-control" />
                <span asp-validation-for="TipoAtestado" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label for="archivo" class="control-label">Archivo</label>
                <input type="file" id="archivo" name="archivo" class="form-control" />
                <span asp-validation-for="RutaArchivo" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Comentarios" class="control-label"></label>
                <textarea asp-for="Comentarios" class="form-control"></textarea>
                <span asp-validation-for="Comentarios" class="text-danger"></span>
            </div>

            <div class="form-group mt-4">
                @if (User.IsInRole("Administrador"))
                {
                    <input type="submit" value="Guardar" class="btn btn-success" />
                }
                <a asp-controller="Personas" asp-action="Details" asp-route-id="@Model.IdPersona" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}