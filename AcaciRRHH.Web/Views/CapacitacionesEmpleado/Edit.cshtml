@model AcaciRRHH.Web.Models.CapacitacionEmpleado

@{
    ViewData["Title"] = "Editar";
}

<h1>Editar</h1>

<h4>Capacitación del Empleado</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="IdCapacitacionEmpleado" />
            <input type="hidden" asp-for="IdPersona" />
            <input type="hidden" asp-for="RutaCertificado" /> @* Keep existing path if no new file is uploaded *@
            <div class="form-group">
                <label asp-for="NombreCurso" class="control-label"></label>
                <input asp-for="NombreCurso" class="form-control" />
                <span asp-validation-for="NombreCurso" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Institucion" class="control-label"></label>
                <input asp-for="Institucion" class="form-control" />
                <span asp-validation-for="Institucion" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="FechaInicio" class="control-label"></label>
                <input asp-for="FechaInicio" class="form-control" />
                <span asp-validation-for="FechaInicio" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="FechaFin" class="control-label"></label>
                <input asp-for="FechaFin" class="form-control" />
                <span asp-validation-for="FechaFin" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="CertificadoObtenido" /> @Html.DisplayNameFor(model => model.CertificadoObtenido)
                </label>
            </div>
            <div class="form-group">
                <label asp-for="ArchivoCertificado" class="control-label"></label>
                <input asp-for="ArchivoCertificado" class="form-control" disabled />
                <span asp-validation-for="ArchivoCertificado" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Comentarios" class="control-label"></label>
                <textarea asp-for="Comentarios" class="form-control" id="comentariosInput" rows="1"></textarea>
                <span asp-validation-for="Comentarios" class="text-danger"></span>

            </div>
            <div class="form-group mt-3">
                <input type="submit" value="Guardar" class="btn btn-primary" /> |
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function () {
            var certificadoCheckbox = $('#CertificadoObtenido');
            var archivoInput = $('#ArchivoCertificado');

            certificadoCheckbox.change(function () {
                archivoInput.prop('disabled', !this.checked);
                if (!this.checked) {
                    archivoInput.val('');
                }
            });

            // Initial state
            archivoInput.prop('disabled', !certificadoCheckbox.is(':checked'));
            
            // Ajuste automático de altura para el campo Comentarios
            function autoResizeTextarea(elem) {
                elem.style.height = 'auto';
                elem.style.height = (elem.scrollHeight) + 'px';
            }

            var comentarios = document.getElementById("comentariosInput");

            if (comentarios) {
                autoResizeTextarea(comentarios); // Ajustar en carga inicial
                comentarios.addEventListener('input', function () {
                    autoResizeTextarea(this);
                });
            }

        });
    </script>
}