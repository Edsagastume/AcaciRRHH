@model AcaciRRHH.Web.Models.CapacitacionEmpleado

@{
    ViewData["Title"] = "Detalle";
}

<h1>Detalle de la Capacitación del Empleado</h1>

<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.NombreCurso)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.NombreCurso)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Institucion)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Institucion)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.FechaInicio)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.FechaInicio)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.FechaFin)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.FechaFin)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ArchivoCertificado)
        </dt> 
        <dd class = "col-sm-10">
            @if (!string.IsNullOrEmpty(Model.RutaCertificado))
            {
                <a href="@Url.Content(Model.RutaCertificado)" target="_blank">Ver Certificado</a>
            }
        </dd>  
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Comentarios)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Comentarios)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Delete" asp-route-id="@Model?.IdCapacitacionEmpleado" class="btn btn-danger">Eliminar</a> |
    <a asp-action="Details" asp-controller="Personas" asp-route-id="@Model?.IdPersona" class="btn btn-secondary">Volver</a>
</div>